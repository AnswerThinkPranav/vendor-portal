# Base URL of the Aragen PR Portal deployment this server talks to.
# Point this at a dev/QA deployment (whose SAP JCo destination targets an SAP
# test client) until the full write-path has been verified end-to-end.
ARAGEN_BASE_URL=http://localhost:8081

# Raw API key matching the BCrypt hash configured server-side as mcp.api-key-hash
# (env var MCP_API_KEY_HASH on the Java app). Never commit the real value.
ARAGEN_MCP_API_KEY=changeme

# Optional: request timeout in seconds (default 30).
ARAGEN_HTTP_TIMEOUT=30
