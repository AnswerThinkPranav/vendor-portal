# --- Database ---
jdbc.url=jdbc:mysql://localhost:3306/aragen?autoReconnect=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=IST
jdbc.user=root
jdbc.pass=CHANGE_ME

# --- SAP JCo (sap.properties values) ---
sap.ashost=192.168.0.102
sap.sysnr=20
sap.client=600
sap.user=EXT_PORTAL
sap.passwd=CHANGE_ME
