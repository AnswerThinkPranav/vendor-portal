# --- File Upload Paths ---
upload.path=/opt/aragen/uploads
app.file.upload-dir=/opt/aragen/uploads

# --- App URL ---
site.url=https://your-domain.com

# --- Logging ---
logging.file.path=/opt/aragen/logs
