jco2.r3_sys_no=01

# --- Mail ---
spring.mail.host=smtp.office365.com
spring.mail.port=587
spring.mail.username=CHANGE_ME
spring.mail.password=CHANGE_ME
mail.fromaddress=CHANGE_ME
