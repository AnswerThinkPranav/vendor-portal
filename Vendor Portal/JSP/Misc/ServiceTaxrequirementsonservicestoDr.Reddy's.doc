{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\froman\fprq2\fcharset0 Tms Rmn;}{\f1\fswiss\fprq2\fcharset0 Helv;}{\f2\fswiss\fprq2\fcharset0 Calibri;}{\f3\fswiss\fcharset0 Arial;}}
